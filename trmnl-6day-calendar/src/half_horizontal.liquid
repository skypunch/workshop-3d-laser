{% comment %} 6-Day Calendar -- HALF HORIZONTAL. Next 3 days across. Plugin Merge strategy. {% endcomment %}
{% assign events = google_calendar_14059.events %}{% comment %} this node = TRMNL's native Google Calendar plugin instance {% endcomment %}
{% assign TZ_FIX = 0 %}{% comment %} set to trmnl.user.utc_offset if days are off {% endcomment %}
{% assign now_epoch = "now" | date: "%s" | plus: trmnl.user.utc_offset %}

<style>
  @font-face { font-family: 'ChicagoFLF'; src: url('https://cdn.jsdelivr.net/npm/chicago.css@1.0.3/ChicagoFLF.ttf') format('truetype'); font-weight: normal; font-style: normal; font-display: swap; }
  .view, .view * { font-family: 'ChicagoFLF', 'Chicago', Helvetica, sans-serif; }
  .nm { display:inline-block; border:2px solid currentColor; border-radius:3px; padding:0 4px; line-height:1.05; }
</style>

<div class="view view--half_horizontal">
  <div class="layout">
    <div class="grid grid--cols-3" style="gap:6px; height:100%;">
      {% for i in (0..2) %}
        {% assign offset_secs = i | times: 86400 %}
        {% assign day_epoch = now_epoch | plus: offset_secs %}
        {% assign day_str = day_epoch | date: "%Y-%m-%d" %}

        <div style="border:2px solid black; display:flex; flex-direction:column; overflow:hidden; min-height:0;">
          <div style="display:flex; justify-content:space-between; align-items:baseline; padding:2px 5px; {% if i == 0 %}background:black; color:white;{% else %}border-bottom:1px solid black;{% endif %}">
            <span style="font-weight:normal; font-size:15px;">{{ day_epoch | date: "%a" }}</span>
            <span style="font-size:12px;">{{ day_epoch | date: "%-d %b" }}</span>
          </div>
          <div style="padding:3px 5px; flex:1; overflow:hidden; min-height:0;">
            {% assign shown = 0 %}
            {% for event in events %}
              {% assign ev_date = event.date_time | date: "%s" | plus: TZ_FIX | date: "%Y-%m-%d" %}
              {% if ev_date == day_str %}
                {% if shown < 3 %}
                  <div style="margin-bottom:2px; line-height:1.1;">
                    {% unless event.all_day %}<span style="font-size:11px; font-weight:normal;">{{ event.start }}</span>{% endunless %}
                    <span style="font-size:12px; display:block;">{{ event.summary | default: "(busy)" | truncate: 24 | replace: "Shahidah", "<span class='nm'>Shahidah</span>" | replace: "Marcus", "<span class='nm'>Marcus</span>" | replace: "Wade", "<span class='nm'>Wade</span>" | replace: "Wesley", "<span class='nm'>Wesley</span>" }}</span>
                  </div>
                {% endif %}
                {% assign shown = shown | plus: 1 %}
              {% endif %}
            {% endfor %}
            {% if shown == 0 %}<span style="font-size:12px; opacity:0.45;">&mdash;</span>{% endif %}
            {% if shown > 3 %}{% assign more = shown | minus: 3 %}<span style="font-size:11px; font-weight:normal;">+{{ more }}</span>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
